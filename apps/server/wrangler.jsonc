{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "whizard",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "PRESENCE", "class_name": "Presence" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["Presence"] },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "whizard",
      // The deploy job looks up the real ID (creating the database the first time) and fills it in.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  // Per-address limits, generous because mobile networks put many people behind one address.
  "ratelimits": [
    { "name": "PRESENCE_LIMIT", "namespace_id": "1001", "simple": { "limit": 100, "period": 60 } },
    { "name": "ROOM_LIMIT", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } },
  ],
  // Daily tidy-up of expired sign-ins and old guest details.
  "triggers": { "crons": ["17 3 * * *"] },
  "observability": { "enabled": true },
}
